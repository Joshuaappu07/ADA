#include <stdio.h>
#include <stdlib.h>
int x[10], n, found = 0;
int safe(int r, int c) {
    for(int i = 1; i < r; i++)
        if(x[i] == c || abs(x[i] - c) == abs(i - r))
            return 0;
    return 1;
}
void queen(int r) {
    if(found) return;
    for(int c = 1; c <= n; c++) {
        if(safe(r, c)) {
            x[r] = c;
            if(r == n) {
                for(int i = 1; i <= n; i++) {
                    for(int j = 1; j <= n; j++)
                        printf(x[i] == j ? "Q " : "- ");
                    printf("\n");
                }
                found = 1;
                return;
            }
            queen(r + 1);
        }
    }
}
int main() {
    printf("Enter N: ");
    scanf("%d", &n);
    queen(1);
    return 0;
}
