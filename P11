#include <stdio.h>
#include <stdlib.h>
#include <time.h>
void merge(int a[], int l, int m, int r) {
    int i = l, j = m + 1, k = 0, b[50000];
    while (i <= m && j <= r)
        b[k++] = (a[i] < a[j]) ? a[i++] : a[j++];
    while (i <= m) b[k++] = a[i++];
    while (j <= r) b[k++] = a[j++];
    for (i = l, k = 0; i <= r; i++, k++)
        a[i] = b[k];
}
void mergesort(int a[], int l, int r) {
    if (l < r) {
        int m = (l + r) / 2;
        mergesort(a, l, m);
        mergesort(a, m + 1, r);
        merge(a, l, m, r);
    }
}
int main() {
    int n, i;
    printf("Enter random numbers for n= ");
    scanf("%d", &n);
    int a[n];
    srand(time(NULL));
    for (i = 0; i < n; i++)
        a[i] = rand() % 10000;
    printf("Original array:\n");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
    clock_t start = clock();
    mergesort(a, 0, n - 1);
    clock_t end = clock();
    printf("Sorted array:\n");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
    printf("Time taken to sort %d elements: %f seconds\n",
           n, (double)(end - start) / CLOCKS_PER_SEC);
    return 0;
}
